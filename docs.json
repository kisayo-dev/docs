    "forceMode": false
  },
  "favicon": "/logo.png",
  "navigation": {
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "href": "index"
      },
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "href": "/introduction"
      },
      {
        "anchor": "API Reference",
        "icon": "code",
        "href": "/api-reference"
      },
      {
        "anchor": "Changelog",
        "icon": "clock-rotate-left",
        "href": "/changelog"
      },
      {
        "anchor": "Help Center",
        "icon": "circle-question",
        "href": "https://help.kisayo.com"
      }
    ],
    "tabs": [
      {
        "tab": "Kisayo Lab",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Pour commencer",
            "pages": [
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Interface Pro",
            "pages": [
              "guides/interface-pro",
              "guides/widgets",
              "guides/integrations"
            ]
          },
          {
            "group": "Personnalisation",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Contenu",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "Outils IA",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Documentation API",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
