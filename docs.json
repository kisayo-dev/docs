{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kisayo Lab",
  "logo": {
    "light": "/logo-2.png",
    "dark": "/logo-2.png"
  },
  "favicon": "/logo.png",
  "colors": {
    "primary": "#FF9F24",
    "light": "#E5C8AC",
    "dark": "#000000",
    "background": {
      "dark": "#050505"
    }
  },
  "backgroundImage": "/grid.svg",
  "appearance": {
    "defaultMode": "dark",
    "forceMode": true
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "href": "index"
      },
      {
        "anchor": "Changelog",
        "icon": "clock-rotate-left",
        "href": "/changelog"
      }
    ],
    "tabs": [
      {
        "tab": "Kisayo Lab",
        "pages": ["index"]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Interface Pro",
            "pages": [
              "guides/interface-pro",
              "guides/vue-generale",
              "guides/reputation",
              "guides/entreprise",
              "guides/developpeurs",
              "guides/abonnements"
            ]
          },
          {
            "group": "Intégration",
            "pages": [
              "guides/webhooks",
              "guides/notifier",
              "guides/securite-authentification"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Documentation API",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.kisayo.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/kisayo",
      "github": "https://github.com/kisayo",
      "linkedin": "https://linkedin.com/company/kisayo"
    }
  }
}